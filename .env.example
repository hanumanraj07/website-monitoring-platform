# PulseWatch Environment Variables

# Database Connection (SQLite local file, or PostgreSQL connection string for production)
DATABASE_URL="file:./dev.db"

# Secret token to protect the /api/cron trigger endpoint
CRON_SECRET="pulsewatch_secret_token_2026"

# Allow local mock endpoints for testing (/api/mock/healthy, slow, down, flaky)
ALLOW_LOCAL_MOCK="true"

# Port
PORT=3000
